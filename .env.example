# Copie para .env e preencha. O arquivo .env não deve ser versionado.

# --- n8n ---
# Chave usada para criptografar as credenciais salvas no n8n. Gere com: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=America/Manaus
# URL pública pela qual o provedor do WhatsApp alcança o webhook
WEBHOOK_URL=

# --- Privacidade: não guardar o conteúdo das mensagens no histórico de execuções ---
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=72

# --- Recursos usados pelo workflow ---
# ID do grupo de WhatsApp da campanha (formato do provedor, ex.: 1203...-group)
WHATSAPP_GROUP_ID=
# ID da planilha (trecho da URL entre /d/ e /edit)
GOOGLE_SHEET_ID=
# ID da aba (número após gid= na URL; a primeira aba costuma ser 0)
GOOGLE_SHEET_TAB=0
